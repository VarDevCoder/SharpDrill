    {
      "name": "4. Drill de código cronometrado",
      "item": [
        {
          "name": "Empezar drill PL/SQL",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "pm.test('Devuelve ticket firmado', () => pm.expect(r.ticket).to.include('.'));",
                  "pm.collectionVariables.set('drillTicket', r.ticket);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/drills/ch14.d1/start",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "drills",
                "ch14.d1",
                "start"
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Entregar solución",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "pm.test('Todas las verificaciones superadas', () => pm.expect(r.passed).to.eql(r.total));",
                  "pm.test('Dentro de tiempo', () => pm.expect(r.inTime).to.be.true);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/drills/ch14.d1/submit",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "drills",
                "ch14.d1",
                "submit"
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ticket\": \"{{drillTicket}}\",\n  \"code\": \"CREATE OR REPLACE PROCEDURE subir_salario (\\n  p_emp_id IN empleados.id%TYPE,\\n  p_pct    IN NUMBER\\n) IS\\nBEGIN\\n  UPDATE empleados\\n     SET salario = salario * (1 + p_pct / 100)\\n   WHERE id = p_emp_id;\\n\\n  IF SQL%ROWCOUNT = 0 THEN\\n    RAISE_APPLICATION_ERROR(-20001, 'Empleado ' || p_emp_id || ' no existe');\\n  END IF;\\nEND subir_salario;\\n/\\n\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Ticket falsificado → 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/drills/ch14.d1/submit",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "drills",
                "ch14.d1",
                "submit"
              ]
            },
            "header": [
