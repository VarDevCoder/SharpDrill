{
  "info": {
    "name": "SharpDrill API",
    "description": "Colección de práctica: autenticación Bearer, encadenado de peticiones, tests de contrato y drills. Ejecutar con `npm run test:api` (Newman).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "apiToken",
      "value": ""
    },
    {
      "key": "apiTokenId",
      "value": ""
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "drillTicket",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Tests de contrato comunes a todas las peticiones",
          "pm.test('Sin errores 5xx', () => pm.expect(pm.response.code).to.be.below(500));",
          "pm.test('Responde JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
          "pm.test('Responde en menos de 2 s', () => pm.expect(pm.response.responseTime).to.be.below(2000));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1. Autenticación",
      "item": [
        {
          "name": "Registro (usuario único)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('email', `qa+${Date.now()}@sharpdrill.dev`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('Devuelve token Bearer', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.tokenType).to.eql('Bearer');",
                  "  pm.expect(json.token).to.be.a('string').and.match(/^sd_/);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"QA Newman\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Esquema de login', () => pm.response.to.have.jsonSchema({",
                  "  type: 'object', required: ['user', 'token', 'tokenType', 'expiresAt'],",
                  "  properties: { token: { type: 'string' }, user: { type: 'object', required: ['id', 'email', 'name'] } },",
                  "}));",
                  "pm.collectionVariables.set('token', json.token); // encadenar: lo usan las siguientes peticiones"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Login con contraseña incorrecta → 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"incorrecta\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Quién soy (Bearer)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Autenticado por Bearer', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.user.email).to.eql(pm.collectionVariables.get('email'));",
                  "  pm.expect(json.authVia).to.eql('bearer');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ]
            },
            "header": []
          }
        },
        {
          "name": "Sin token → 401 con WWW-Authenticate",
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401', () => pm.response.to.have.status(401));",
                  "pm.test('Cabecera WWW-Authenticate: Bearer', () => pm.expect(pm.response.headers.get('WWW-Authenticate')).to.match(/^Bearer/));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/stats",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "stats"
              ]
            },
            "header": [],
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Token inválido → 401 invalid_token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('invalid_token', () => pm.expect(pm.response.headers.get('WWW-Authenticate')).to.include('invalid_token'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/stats",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "stats"
              ]
            },
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "sd_token_falso",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2. Contenido",
      "item": [
        {
          "name": "Capítulos y rutas",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('6 rutas de aprendizaje', () => pm.expect(json.tracks.map(t => t.id)).to.have.members(['csharp-basics', 'csharp', 'db', 'react', 'api', 'english']));",
                  "pm.test('Hay capítulos de PL/SQL', () => pm.expect(json.chapters.some(c => c.track === 'db')).to.be.true);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/chapters",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "chapters"
              ]
            },
            "header": []
          }
        },
        {
          "name": "Capítulo PL/SQL sin respuestas expuestas",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const ch = pm.response.json().chapter;",
                  "pm.test('Las preguntas no incluyen la respuesta', () => ch.questions.forEach(q => pm.expect(q).to.not.have.property('answer')));",
                  "pm.test('Los drills no incluyen la solución', () => ch.drills.forEach(d => pm.expect(d).to.not.have.property('solution')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/chapters/ch14",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "chapters",
                "ch14"
              ]
            },
            "header": []
          }
        },
        {
          "name": "Buscar \"BULK COLLECT\"",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Encuentra resultados', () => pm.expect(pm.response.json().results.length).to.be.above(0));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/chapters/search?q=BULK%20COLLECT",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
