              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Solo bash', () => pm.response.json().snippets.forEach(s => pm.expect(s.lang).to.eql('bash')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/snippets?lang=bash",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "snippets"
              ],
              "query": [
                {
                  "key": "lang",
                  "value": "bash"
                }
              ]
            },
            "header": []
          }
        }
      ]
