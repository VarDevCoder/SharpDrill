{
  "name": "sharpdrill",
  "version": "1.0.0",
  "description": "Entrenamiento senior con repaso activo: C#/.NET, Oracle SQL y PL/SQL, React/Next.js y APIs (curl, Bearer, Postman, APIM).",
  "type": "module",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/src/server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch server/src/server.js",
    "dev:web": "vite web",
    "build": "vite build web",
    "typecheck": "tsc -p web --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --test server/test/*.test.js",
    "test:api": "newman run postman/SharpDrill.postman_collection.json -e postman/local.postman_environment.json",
    "validate": "node --disable-warning=ExperimentalWarning server/src/validate-content.js",
    "check": "npm run validate && npm test && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@uiw/react-codemirror": "^4.25.12",
    "express": "^5.1.0",
    "js-yaml": "^4.1.0",
    "oracledb": "^6.10.0",
    "prismjs": "^1.30.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "newman": "^6.2.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
